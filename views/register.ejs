<!DOCTYPE html>
<html lang="en">
<head>
    <title>Resgister</title>
</head>
<body>
    <h1>
        Register to Our Secret Society
    </h1>

    <form action="/register" method="POST">
    Enter First name:
    <br><input type="text" name="firstname">
    <br>Enter Last name:
    <br><input type="text" name="lastname">
    <br>Enter Email:
    <br><input type="email" name="email">
    <br>Enter Password:
    <br><input type="password" name="password">
    <br>Confirm Password:
    <br><input type="password" name="confirmpw">
    <br> Have a membership:
    <br><input type="checkbox" name="isMember">
    <br><br><input type="submit" value="Submit">
    </form>

</body>
</html>